# OpenRouter API key (required for LLM evaluation)
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Weights & Biases (creativity_rl track)
# Get one at https://wandb.ai/authorize
WANDB_API_KEY=your-wandb-api-key-here
WANDB_PROJECT=comb-creat-eval
WANDB_ENTITY=

# Lambda Labs Cloud API (creativity_rl track — remote GPU)
# Get one at https://cloud.lambdalabs.com/api-keys
LAMBDA_CLOUD_API_KEY=your-lambda-api-key-here
LAMBDA_SSH_KEY_PATH=/path/to/lambda_ssh_key.pem

# HuggingFace token (for gated models — Llama, Skywork, etc.)
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=your-hf-token-here
